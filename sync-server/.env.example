# Vercel project env vars for the passkey functions (Project → Settings → Environment
# Variables, Production). See ../SETUP-SYNC.md for where each value comes from.

# The Firebase service-account JSON, pasted as ONE line/string. Secret: Vercel env only,
# never committed, never put in the app build.
FIREBASE_SERVICE_ACCOUNT=

# WebAuthn relying party. Defaults already match the production domain; set them only if
# the domain changes. RP_ID must be the bare host, ORIGIN the full https origin.
WEBAUTHN_RP_ID=your-app.vercel.app
WEBAUTHN_ORIGIN=https://your-app.vercel.app
WEBAUTHN_RP_NAME=openGym

# Optional: rest timer push with the phone locked, via Upstash QStash
# (SETUP-SYNC.md, the QStash section). All five or the feature stays off and
# the local rest alert is the whole story. The VAPID pair comes from
# `npx web-push generate-vapid-keys`; the private key is a secret, Vercel env
# only. The QStash token and signing keys come from the QStash console.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: the VAPID contact the push services see. Defaults to the app origin.
VAPID_SUBJECT=
